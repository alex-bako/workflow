--- a/src/money.mjs
+++ b/src/money.mjs
@@ -1,19 +1,23 @@
-// Money helpers.
+// Money helpers. Amounts are integer cents everywhere.
 
 /**
  * Parse a user-entered price such as "12.50" or "$3".
- * @returns {number} the amount in dollars, e.g. 12.5
+ * @returns {number} the amount in integer cents, e.g. 1250
  * @throws {RangeError} when the text is not a non-negative amount below one million with at most two decimals
  */
 export function parseAmount(text) {
-  const value = Number(String(text).trim().replace(/^\$/, ""));
-  if (!/^\$?\d{1,6}(\.\d{1,2})?$/.test(String(text).trim())) throw new RangeError(`bad amount: ${text}`);
-  return value;
+  const m = /^\$?(\d{1,6})(?:\.(\d{1,2}))?$/.exec(String(text).trim());
+  if (!m) throw new RangeError(`bad amount: ${text}`);
+  return Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0"));
 }
 
-/** Format a dollar amount as "$12.50". */
-export function formatAmount(dollars) {
-  return `$${dollars.toFixed(2)}`;
+/**
+ * Format integer cents as "$12.50".
+ * @throws {RangeError} unless cents is a non-negative safe integer
+ */
+export function formatAmount(cents) {
+  if (!Number.isSafeInteger(cents) || cents < 0) throw new RangeError(`bad cents: ${cents}`);
+  return `$${(cents - (cents % 100)) / 100}.${String(cents % 100).padStart(2, "0")}`;
 }
 
 /** Quantity of an order line: a whole number from 1 to 9999. */
